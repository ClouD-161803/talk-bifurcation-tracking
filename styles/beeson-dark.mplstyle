figure.facecolor: none
axes.facecolor: none
savefig.facecolor: none
savefig.transparent: True
savefig.dpi: 200
figure.figsize: 8, 4.5
figure.constrained_layout.use: True

font.family: serif
font.serif: Latin Modern Roman, cmr10, DejaVu Serif
mathtext.fontset: cm
axes.formatter.use_mathtext: True
font.size: 18

text.color: f2f2ef
axes.labelcolor: f2f2ef
axes.titlecolor: f2f2ef
axes.edgecolor: a6a6a0
xtick.color: a6a6a0
ytick.color: a6a6a0
xtick.labelcolor: f2f2ef
ytick.labelcolor: f2f2ef
grid.color: 232320

lines.linewidth: 2.7
axes.linewidth: 1.44
grid.linewidth: 1.44
xtick.major.width: 1.44
ytick.major.width: 1.44
xtick.minor.width: 1.08
ytick.minor.width: 1.08

axes.spines.top: False
axes.spines.right: False
legend.frameon: False

axes.prop_cycle: cycler('color', ['E69F00', '56B4E9', '009E73', 'F0E442', '0072B2', 'D55E00', 'CC79A7', 'f2f2ef'])
